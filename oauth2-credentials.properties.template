# 🔐 Configuration OAuth2 - Template

# Copiez ce fichier et renommez-le en "oauth2-credentials.properties"
# Puis remplissez avec vos vraies credentials OAuth2

# ==============================================
# GOOGLE OAUTH2
# ==============================================
# Console: https://console.cloud.google.com/
# 1. Créer un projet
# 2. APIs & Services > Credentials > Create Credentials > OAuth client ID
# 3. Type: Web application
# 4. Authorized redirect URIs: http://localhost:8080/login/oauth2/code/google

spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID_HERE
spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET_HERE

# ==============================================
# FACEBOOK OAUTH2
# ==============================================
# Console: https://developers.facebook.com/
# 1. Créer une application
# 2. Settings > Basic
# 3. Add Product: Facebook Login
# 4. Facebook Login > Settings > Valid OAuth Redirect URIs: http://localhost:8080/login/oauth2/code/facebook

spring.security.oauth2.client.registration.facebook.client-id=YOUR_FACEBOOK_APP_ID_HERE
spring.security.oauth2.client.registration.facebook.client-secret=YOUR_FACEBOOK_APP_SECRET_HERE

# ==============================================
# LINKEDIN OAUTH2
# ==============================================
# Console: https://www.linkedin.com/developers/
# 1. Créer une application
# 2. Auth > Redirect URLs: http://localhost:8080/login/oauth2/code/linkedin
# 3. Products: Sign In with LinkedIn using OpenID Connect

spring.security.oauth2.client.registration.linkedin.client-id=YOUR_LINKEDIN_CLIENT_ID_HERE
spring.security.oauth2.client.registration.linkedin.client-secret=YOUR_LINKEDIN_CLIENT_SECRET_HERE

# ==============================================
# NOTES
# ==============================================
# - Ne commitez JAMAIS vos vraies credentials dans Git
# - Ajoutez oauth2-credentials.properties dans .gitignore
# - Pour la production, utilisez des variables d'environnement
# - Les redirect URIs doivent correspondre exactement à celles configurées dans les consoles

